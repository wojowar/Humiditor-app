# Band-photo identification. Without this the scan screen still works - it just
# opens the form blank instead of prefilling it.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Pulling humidity from a Govee hygrometer. Optional; manual entry works without
# it. In the Govee Home app: Profile -> Settings -> Apply for API Key.
# Only WiFi and gateway-backed sensors report to Govee's cloud - a Bluetooth-only
# unit (H5075, H5074) will not appear, no matter the key.
GOVEE_API_KEY=
